# Serveur OpenCode local (agent d'édition) — lancé avec `opencode serve --port 4096`.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_TIMEOUT=90

# Clés LLM (utilisées par les tchats Gemini/Groq, si l'agent OpenCode est indisponible).
GEMINI_API_KEY=
GROQ_API_KEY=

# Origines CORS autorisées (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173