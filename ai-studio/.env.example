# ─────────────────────────────────────────────────────────────────────────────
# AI Studio — variables d'environnement (COPIEZ CE FICHIER EN `.env`)
#
#   cp .env.example .env     (ou   copy .env.example .env   sous Windows)
#
# `.env` est ignoré par Git et ne doit JAMAIS être commité : il contient les
# clés API. AUCUNE valeur n'est fournie ici, volontairement : ce fichier sert
# uniquement à lister les noms de variables acceptés. Une variable vide ou
# absente retombe sur la valeur par défaut du code (app/config.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur OpenCode local (agent d'édition) ────────────────────────────────
# Lancé avec `opencode serve --port 4096`.
OPENCODE_BASE_URL=
# Serveur DÉDIÉ au mode autonome, sur un port DIFFÉRENT (4097 par défaut).
# Il porte `AISTUDIO_AGENT`, qui fait passer les commandes serveur en arrière-plan.
# Ne jamais le confondre avec OPENCODE_BASE_URL : répondre à une permission ou
# annuler une tâche sur le mauvais serveur échoue sans aucune erreur visible.
OPENCODE_AGENT_BASE_URL=
OPENCODE_TIMEOUT=
# Chemin explicite du binaire CLI `opencode` (vide = résolution auto via
# `npm prefix -g`, puis le shim du PATH). À renseigner seulement si la
# résolution automatique échoue.
OPENCODE_BIN=
# Modèle passé explicitement à la CLI pour le mode autonome.
OPENCODE_MODEL=
# Durée maximale d'une tâche agent autonome, en secondes.
TACHE_TIMEOUT=
# Longueur des résumés de sortie d'outil (events `outil`) et des aperçus de diff.
OUTIL_RESUME_MAX=
OUTIL_APERCU_MAX=

# ── Clés API des moteurs LLM de repli ──────────────────────────────────────
# Utilisées quand l'agent OpenCode est indisponible (discussion / édition).
# Laisser vide désactive le moteur concerné.
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Moteurs LLM ────────────────────────────────────────────────────────────
# Délai réseau maximal d'un appel LLM, en millisecondes.
AI_TIMEOUT_MS=
GEMINI_MODEL=
GROQ_MODEL=
# Modèle Groq vision utilisé automatiquement quand une image est jointe.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Budgets de contexte envoyés à l'agent (anti-explosion de tokens) ──────
# Calibrés pour rester sous la limite la plus basse des moteurs de repli.
ARBRE_CONTEXTE_MAX=
# Durée de mise en cache de l'arborescence du projet, en secondes.
ARBORESCENCE_CACHE_SECONDES=
# Taille max du contexte d'un fichier, en caractères.
FICHIER_CONTEXTE_MAX_CAR=
# Nombre max de fichiers dont le contenu est inclus dans le prompt.
FICHIERS_CONTEXTE_MAX=
# Taille totale max du contexte, en caractères.
CONTEXTE_MAX_CAR=
# Nombre max d'échanges conservés dans la mémoire d'un fil.
MEMOIRE_ECHANGES_MAX=

# ── RAG (documents de cours PDF/TXT/MD et index FAISS) ─────────────────────
MODELE_EMBEDDING=
RAG_TAILLE_CHUNK=
RAG_CHEVAUCHEMENT=
RAG_K=

# ── Purge des dictionnaires globaux du backend ─────────────────────────────
# Durée de vie maximale d'une entrée en mémoire, en secondes.
TTL_MEMOIRE_SECONDES=
# Nombre maximum d'entrées par dictionnaire ; au-delà, les plus anciennes
# sont supprimées.
MAX_ENTREES_MEMOIRE=

# ── Chemins de données (optionnels, relatifs à la racine du dépôt) ────────
# Par défaut <racine>/data, ou %LOCALAPPDATA%\AIStudio\data en exécutable.
# DATA_DIR=
# PROJETS_DIR=
# MEMOIRE_DIR=
# DOCUMENTS_DIR=
# INDEX_DIR=
# REGISTRE_FICHIER=
# ORGANIZER_DB=
# Journaux (aistudio.log). Sans console, c'est le SEUL canal de diagnostic
# d'un exécutable compilé : un plantage au démarrage y laisse une trace.
# LOGS_DIR=

# ── Réseau ─────────────────────────────────────────────────────────────────
# Origines CORS autorisées, séparées par des virgules (dev : Vite).
CORS_ORIGINS=
